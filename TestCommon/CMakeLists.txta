add_library(test_unity STATIC ../third_party/unity/src/unity.c)
target_include_directories(test_unity PUBLIC ../third_party/unity/src)

add_library(test_subject STATIC ../blk_buf.c)
target_include_directories(test_subject PUBLIC ..)

foreach(suite IN ITEMS blk_buf linked_list)
    add_executable(test_${suite} test_${suite}.c)
    target_link_libraries(test_${suite} PRIVATE test_subject test_unity)
    if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(test_${suite} PRIVATE -Wall -Wextra -Wpedantic)
    endif()

    # The registration table is the single source of truth for test discovery.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS test_${suite}.c)
    file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/test_${suite}.c" cases
         REGEX "^[ ]+TEST_CASE\\(test_[A-Za-z0-9_]+\\)")
    foreach(entry IN LISTS cases)
        string(REGEX MATCH "test_[A-Za-z0-9_]+" case_name "${entry}")
        add_test(NAME ${suite}.${case_name} COMMAND test_${suite} ${case_name})
        set_tests_properties(${suite}.${case_name} PROPERTIES TIMEOUT 5 LABELS ${suite})
    endforeach()
endforeach()
